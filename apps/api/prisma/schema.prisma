generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  name             String?
  password         String?
  googleId         String?        @unique
  role             UserRole       @default(USER)
  isPremium        Boolean        @default(false)
  premiumExpiresAt DateTime?
  avatarUrl        String?
  headline         String?
  bio              String?        @db.Text
  githubUrl        String?
  linkedinUrl      String?
  websiteUrl       String?
  bookmarks        Bookmark[]
  progress         UserProgress[]
  questions        Question[]     @relation("AuthoredQuestions")
  orders           Order[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

enum OrderStatus {
  PENDING
  SUCCESS
  CANCELLED
  EXPIRED
  FAILED
}

model Order {
  id            String      @id @default(uuid())
  orderCode     Int         @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  description   String
  status        OrderStatus @default(PENDING)
  paymentLinkId String?
  checkoutUrl   String?
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([orderCode])
  @@index([userId, status])
  @@index([status, createdAt])
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  questions   Question[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Technology {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  icon      String?
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Question {
  id           String         @id @default(uuid())
  title        String
  slug         String         @unique
  content      String         @db.Text
  difficulty   Difficulty     @default(MEDIUM)
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  technologyId String
  technology   Technology     @relation(fields: [technologyId], references: [id], onDelete: Restrict)
  authorId     String?
  author       User?          @relation("AuthoredQuestions", fields: [authorId], references: [id], onDelete: SetNull)
  answer       Answer?
  bookmarks    Bookmark[]
  progress     UserProgress[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([technologyId])
  @@index([difficulty])
  @@index([createdAt])
  @@index([authorId])
  @@index([categoryId, createdAt])
  @@index([technologyId, createdAt])
  @@index([difficulty, createdAt])
  @@index([categoryId, technologyId, difficulty])
}

model Answer {
  id          String   @id @default(uuid())
  questionId  String   @unique
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  codeSnippet String?  @db.Text
  explanation String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([questionId])
}

model UserProgress {
  id         String         @id @default(uuid())
  userId     String
  questionId String
  status     ProgressStatus @default(NOT_STARTED)
  notes      String?        @db.Text
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, status])
  @@index([questionId])
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  visitorId String?
  ip        String?
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
}

